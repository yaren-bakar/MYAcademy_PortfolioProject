@model MYAcademy_PortfolioProject.Entities.HeroSection

@{
    ViewData["Title"] = "Profil Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h3 class="fw-bold mb-1">Profil Yönetimi</h3>
        <p class="text-muted mb-0">Ana sayfanızın karşılama alanında görünen bilgileri buradan yönetebilirsiniz.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-person-x display-6 d-block mb-2"></i>
                Henüz profil bilgisi bulunmuyor.
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden">

            <div style="height: 120px; background: linear-gradient(135deg, #4f46e5, #0284c7);"></div>

            <div class="card-body px-4 pb-4" style="margin-top: -70px;">
                <div class="row g-4 align-items-end">

                    <div class="col-auto">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.SubTitle"
                                 class="rounded-circle border border-4 border-white shadow"
                                 style="width: 140px; height: 140px; object-fit: cover; background: #fff;" />
                        }
                        else
                        {
                            <div class="rounded-circle border border-4 border-white shadow d-flex align-items-center justify-content-center bg-light text-muted"
                                 style="width: 140px; height: 140px;">
                                <i class="bi bi-person fs-1"></i>
                            </div>
                        }
                    </div>

                    <div class="col">
                        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2" style="padding-top: 80px;">
                            <div>
                                <h4 class="fw-bold mb-0">@Model.SubTitle</h4>
                                <span class="text-muted">Ana Sayfa Karşılama Alanı</span>
                            </div>
                            <button type="button" class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#updateModal">
                                <i class="bi bi-pencil-square me-1"></i> Profili Düzenle
                            </button>
                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light h-100">
                            <div class="small text-muted fw-semibold mb-1">
                                <i class="bi bi-type-h1 me-1"></i> Başlık
                            </div>
                            <div class="fw-semibold">@Model.Title</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light h-100">
                            <div class="small text-muted fw-semibold mb-1">
                                <i class="bi bi-person-badge me-1"></i> Alt Başlık
                            </div>
                            <div class="fw-semibold">@Model.SubTitle</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 rounded-3 bg-light">
                            <div class="small text-muted fw-semibold mb-1">
                                <i class="bi bi-card-text me-1"></i> Açıklama
                            </div>
                            <div style="white-space: pre-wrap;">@Model.Description</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 rounded-3 bg-light">
                            <div class="small text-muted fw-semibold mb-1">
                                <i class="bi bi-image me-1"></i> Görsel Adresi
                            </div>
                            <div class="text-break small">@(string.IsNullOrEmpty(Model.ImageUrl) ? "-" : Model.ImageUrl)</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="modal fade" id="updateModal" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" asp-area="Admin" asp-controller="HeroSection" asp-action="HeroSectionList" enctype="multipart/form-data">
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold">Profili Düzenle</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" asp-for="HeroSectionID" />
                            <input type="hidden" asp-for="ImageUrl" />

                            <div class="row g-3">
                                <div class="col-12 text-center">
                                    <img id="previewImage" src="@Model.ImageUrl" alt="Önizleme"
                                         class="rounded-circle border shadow-sm"
                                         style="width: 120px; height: 120px; object-fit: cover;" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Profil Fotoğrafı</label>
                                    <input type="file" name="imageFile" id="imageFile" accept="image/*" class="form-control" />
                                    <div class="form-text">Yeni dosya seçmezseniz mevcut görsel korunur.</div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Başlık</label>
                                    <input asp-for="Title" class="form-control" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Alt Başlık</label>
                                    <input asp-for="SubTitle" class="form-control" required />
                                </div>

                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Açıklama</label>
                                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-arrow-repeat me-1"></i> Güncelle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('imageFile').addEventListener('change', function () {
                var file = this.files[0];
                if (file) {
                    document.getElementById('previewImage').src = URL.createObjectURL(file);
                }
            });
        </script>
    }

</div>