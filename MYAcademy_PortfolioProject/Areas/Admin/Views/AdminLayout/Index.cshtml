@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")
@await RenderSectionAsync("Styles", required: false)
<body>

    @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")

    @await Component.InvokeAsync("_AdminLayoutMobilSidebarComponentPartial")

    <div id="main-content-wrapper">
        <main class="main-body-container">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await Component.InvokeAsync("_AdminLayoutScriptComponentPartial")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>