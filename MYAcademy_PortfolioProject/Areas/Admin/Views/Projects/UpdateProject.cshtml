@model MYAcademy_PortfolioProject.Entities.Project

@{
    ViewData["Title"] = "Proje Düzenle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white p-4">
                    <h4 class="fw-bold mb-1">Proje Bilgilerini Düzenle</h4>
                    <p class="text-muted mb-0">
                        Projenizin detaylarını ve görsel URL adresini aşağıdaki formdan güncelleyebilirsiniz.
                    </p>
                </div>

                <div class="card-body p-4">
                    <form method="post">

                        <!-- Veri kaybını önlemek için gizli ID alanı -->
                        <input type="hidden" asp-for="ProjectID" />

                        <div class="row g-4">

                            <!-- Proje Adı -->
                            <div class="col-md-6">
                                <label asp-for="Title" class="form-label fw-semibold">Proje Başlığı</label>
                                <input type="text" asp-for="Title" class="form-control" required />
                            </div>

                            <!-- Kategori Seçimi -->
                            <div class="col-md-6">
                                <label asp-for="CategoryID" class="form-label fw-semibold">Proje Kategorisi</label>
                                <select asp-for="CategoryID" asp-items="ViewBag.CategoryList" class="form-select" required>
                                    <option value="">-- Kategori Seçiniz --</option>
                                </select>
                            </div>

                            <!-- Kapak Görseli URL -->
                            <div class="col-md-12">
                                <label asp-for="CoverImageUrl" class="form-label fw-semibold">Proje Görsel URL</label>
                                <input type="text" asp-for="CoverImageUrl" class="form-control" placeholder="https://unsplash.com... veya resim linki" />
                            </div>

                            <!-- Github Linki -->
                            <div class="col-md-12">
                                <label asp-for="GithubUrl" class="form-label fw-semibold">Github Proje Linki</label>
                                <input type="text" asp-for="GithubUrl" class="form-control" placeholder="https://github.com" />
                            </div>

                            <!-- Proje Açıklaması -->
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">Proje Açıklaması</label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/Admin/Project/ProjectList" class="btn btn-outline-secondary">
                                Vazgeç
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
