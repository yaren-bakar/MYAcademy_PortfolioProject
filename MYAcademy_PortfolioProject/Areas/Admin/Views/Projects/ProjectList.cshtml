@model List<MYAcademy_PortfolioProject.Entities.Project>

@{
    ViewData["Title"] = "Proje Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Proje Yönetimi</h3>
            <p class="text-muted mb-0">
                Proje bilgilerinizi buradan yönetebilirsiniz.
            </p>
        </div>

        <a href="/Admin/Projects/CreateProject" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Yeni Proje Ekle
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Projelerim</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Proje Görseli</th>
                            <th>Proje Adı</th>
                            <th>Kategori</th>
                            <th>Github Linki</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ProjectID</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                    {
                                        <img src="@item.CoverImageUrl" alt="@item.Title" class="rounded" style="width: 80px;" />
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Görsel Yok</span>
                                    }
                                </td>
                                <td class="fw-semibold">@item.Title</td>
                                <td>
                                    <span class="badge bg-info text-dark">@(item.Category != null ? item.Category.CategoryName : "Kategori Yok")</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.GithubUrl))
                                    {
                                        <a href="https://@item.GithubUrl" target="_blank" class="btn btn-link text-decoration-none p-0">
                                            <i class="bi bi-github"></i> Github'a Git
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="/Admin/Projects/UpdateProject/@item.ProjectID" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil-square"></i> Güncelle
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-@item.ProjectID">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            @foreach (var item in Model)
            {
                <div class="modal fade" id="deleteModal-@item.ProjectID" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Silme Onayı</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <strong>@item.Title</strong> projesini silmek istediğinize emin misiniz?
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                                <a href="/Admin/Projects/DeleteProject/@item.ProjectID" class="btn btn-danger">Evet, Sil</a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-4 text-muted">
                    Henüz proje bilgisi eklenmemiş.
                </div>
            }
        </div>
    </div>

</div>