@model List<MYAcademy_PortfolioProject.Entities.Experience>

@{
    ViewData["Title"] = "Deneyim Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Deneyim Yönetimi</h3>
            <p class="text-muted mb-0">
                Portfolyonuzdaki deneyimleri buradan yönetebilirsiniz.
            </p>
        </div>

        <div class="experience-count">
            <span class="text-muted">Toplam Deneyim</span>
            <h4 class="fw-bold mb-0">@Model.Count</h4>
        </div>
    </div>

    <!-- Deneyim Tablosu -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">
            <h5 class="fw-bold mb-0">Deneyim Listesi</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Başlık</th>
                                <th>Alt Başlık</th>
                                <th>Tarih</th>
                                <th>Durum</th>
                                <th class="text-center">İşlemler</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">
                                        @item.ExperienceID
                                    </td>

                                    <td class="fw-semibold">
                                        @item.Title
                                    </td>

                                    <td class="text-muted">
                                        @item.SideTitle
                                    </td>

                                    <td>
                                        @item.Duration
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="status-badge active">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge passive">
                                                Pasif
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <a href="/Admin/Experience/UpdateExperience/@item.ExperienceID"
                                           class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil-square"></i>
                                            Güncelle
                                        </a>

                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-@item.ExperienceID">
                                            <i class="bi bi-trash"></i> Sil
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-folder2-open fs-1 text-muted"></i>
                    <h5 class="mt-3">Henüz deneyim eklenmemiş</h5>
                    <p class="text-muted mb-0">
                        Eklediğiniz deneyimler burada listelenecektir.
                    </p>
                </div>
            }

            @foreach (var item in Model)
            {
                <div class="modal fade" id="deleteModal-@item.ExperienceID" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Silme Onayı</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <strong>@item.Title</strong> deneyimini silmek istediğinize emin misiniz?
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                                <a href="/Admin/Experience/DeleteExperience/@item.ExperienceID" class="btn btn-danger">Evet, Sil</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
         
        </div>

    </div>
    <br />
    <a href="/Admin/Experience/CreateExperience"
       class="btn btn-sm btn-outline-success">
        <i class="bi bi-plus"></i>
        Yeni Deneyim Ekle
    </a>
</div>


