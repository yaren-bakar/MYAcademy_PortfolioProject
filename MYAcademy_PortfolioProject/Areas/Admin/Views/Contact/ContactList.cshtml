@model MYAcademy_PortfolioProject.Entities.Contact

@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="mb-4">
        <h3 class="fw-bold mb-1">İletişim Bilgileri Yönetimi</h3>
        <p class="text-muted mb-0">
            Sitenizin iletişim bölümünde görünen bilgileri buradan güncelleyebilirsiniz.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">İletişim Kartı Detayları</h5>
        </div>

        <div class="card-body">
            <form method="post" action="/Admin/Contact/ContactList">
                <input type="hidden" asp-for="ContactID" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">E-posta Adresi</label>
                        <input type="email" asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Konum</label>
                        <input type="text" asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">LinkedIn Adresi</label>
                        <input type="text" asp-for="Linkedin" class="form-control" />
                        <span asp-validation-for="Linkedin" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">GitHub Adresi</label>
                        <input type="text" asp-for="Github" class="form-control" />
                        <span asp-validation-for="Github" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Üst Açıklama Metni</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Alt Bilgi Notu (Yanıt Süresi vb.)</label>
                        <input type="text" asp-for="SubDescription" class="form-control" />
                        <span asp-validation-for="SubDescription" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-2"></i> Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
