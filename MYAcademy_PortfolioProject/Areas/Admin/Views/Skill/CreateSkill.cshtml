@model MYAcademy_PortfolioProject.Entities.Skill

@{
    ViewData["Title"] = "Yetenek Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- SAYFA BAŞLIĞI -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1">Yetenek & Teknoloji Yönetimi</h3>
        <p class="text-muted mb-0">Yeni Yetenek Ekle.</p>
    </div>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-primary">
                <i class="bi bi-plus-circle me-1"></i> Yeni Yetenek / Teknoloji Ekle
            </h5>
        </div>
        <div class="card-body">
            <form action="/Admin/Skill/CreateSkill" method="post">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold">Yetenek / Teknoloji Adı</label>
                        <input type="text" asp-for="SkillName" class="form-control" placeholder="Örn: ASP.NET Core, React, Docker" required />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold">Bağlı Olduğu Kategori</label>
                        <select asp-for="SkillCategoryID" asp-items="ViewBag.CategoryList" class="form-select" required>
                            <option value="">-- Kategori Seçiniz --</option>
                        </select>
                    </div>

                    <!-- Kaydet Butonu -->
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-lg"></i> Yeteneği Ekle
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>
    </div>
