
@model List<MYAcademy_PortfolioProject.Entities.Education>

@{
    ViewData["Title"] = "Eğitim Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Eğitim Yönetimi</h3>
            <p class="text-muted mb-0">
                Eğitim bilgilerinizi buradan yönetebilirsiniz.
            </p>
        </div>

        <a href="/Admin/Education/CreateEducation"
           class="btn btn-success">
            <i class="fas fa-plus me-2"></i> Yeni Eğitim Ekle
        </a>
    </div>

    <!-- Eğitim Tablosu -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Eğitimlerim</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Eğitim Adı</th>
                            <th>Kurum Adı</th>
                            <th>Süre</th>
                            <th>İşlemler</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.EducationID</td>
                                <td class="fw-semibold">@item.Title</td>
                                <td>@item.SubTitle</td>
                                <td>@item.Duration</td>

                                <td >
                                    <a href="/Admin/Education/UpdateEducation/@item.EducationID"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil-square"></i>
                                        Güncelle
                                    </a>

                             </td>
                                <td>
                                    <button type="button" class="btn btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-@item.EducationID">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
                </div>
            @foreach (var item in Model)
            {

                <div class="modal fade" id="deleteModal-@item.EducationID" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Silme Onayı</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                Bu mesajı silmek istediğinize emin misiniz?
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                                <a href="~/Admin/Education/DeleteEducation/@item.EducationID" class="btn btn-danger">Evet, Sil</a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-4 text-muted">
                    Henüz eğitim bilgisi eklenmemiş.
                </div>
            }
        </div>
    </div>

</div>
