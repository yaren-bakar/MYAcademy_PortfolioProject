@model MYAcademy_PortfolioProject.Entities.Education

@{
    ViewData["Title"] = "Eğitim Düzenle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white p-4">
                    <h4 class="fw-bold mb-1">Eğitim Bilgilerini Düzenle</h4>
                    <p class="text-muted mb-0">
                        Eğitim bilgilerinizi aşağıdaki formdan güncelleyebilirsiniz.
                    </p>
                </div>

                <div class="card-body p-4">

                    <form method="post">

                        <!-- Güncelleme işlemi için Id değerini tutan gizli input -->
                        <input type="hidden" asp-for="EducationID" />

                        <div class="row g-4">

                            <!-- Başlık -->
                            <div class="col-md-6">
                                <label asp-for="Title" class="form-label fw-semibold">
                                    Başlık
                                </label>
                                <input type="text" asp-for="Title" class="form-control" />
                            </div>

                            <!-- Şirket Adı -->
                            <div class="col-md-6">
                                <label asp-for="SubTitle" class="form-label fw-semibold">
                                    Kurum Adı
                                </label>
                                <input type="text" asp-for="SubTitle" class="form-control" />
                            </div>

                            <!-- Alt Başlık -->
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    Açıklama
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            </div>

                            <!-- Çalışma Zamanı -->
                            <div class="col-md-6">
                                <label asp-for="Duration" class="form-label fw-semibold">
                                    Çalışma Zamanı
                                </label>
                                <input type="text" asp-for="Duration" class="form-control" />
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">

                            <a href="/Admin/Education/EducationList" class="btn btn-outline-secondary">
                                Vazgeç
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i>
                                Değişiklikleri Kaydet
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
