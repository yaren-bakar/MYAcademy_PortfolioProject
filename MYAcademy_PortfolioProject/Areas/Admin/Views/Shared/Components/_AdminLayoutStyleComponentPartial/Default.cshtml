<style>
    :root {
        /* Sidebar Colors */
        --sidebar-bg: #2E4636;
        --sidebar-surface: #4A6B54;
        --sidebar-active: #557A5E;
        --sidebar-text: #E6EEDD;
        --sidebar-active-text: #FFFFFF;
        --sidebar-border: rgba(230, 238, 221, 0.10);
        /* Main Content Colors */
        --bg-main: #FBF8F1;
        --card-bg: #FFFEFA;
        --text-primary: #2F3A32;
        --text-secondary: #7A8479;
        --primary-accent: #557A5E;
        --primary-accent-hover: #3F6049;
        --border-color: #E9E3D3;
        /* Pastels & Badges */
        --pastel-purple: #E6EEDD;
        --pastel-purple-text: #2F3A32;
        --pastel-blue: #E3EDE8;
        --pastel-blue-text: #2F3A32;
        --mint-green: #DCEBDD;
        --mint-green-text: #2E6B45;
        --peach: #F7E9D7;
        --peach-text: #B0651F;
        --soft-red: #FBECE8;
        --soft-red-text: #c0342b;
        --soft-gray: #EFEADC;
        --soft-gray-text: #6B6F62;
        /* UI Tokens */
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 20px;
        --shadow-subtle: 0 4px 20px rgba(47, 58, 50, 0.04);
        --shadow-card: 0 10px 30px rgba(47, 58, 50, 0.05);
        --shadow-dropdown: 0 14px 34px rgba(47, 58, 50, 0.12);
        --transition-base: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: var(--bg-main);
        color: var(--text-primary);
        margin: 0;
        padding: 0;
        min-height: 100vh;
        display: flex;
        overflow-x: hidden;
        font-size: 0.925rem;
    }

    h1, h2, h3, h4, h5, h6, .font-heading {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: var(--text-primary);
        letter-spacing: -0.02em;
    }

    /* Scrollbar */
    ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    ::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.03);
    }

    ::-webkit-scrollbar-thumb {
        background: #CFD6C3;
        border-radius: 4px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #B3BFA8;
        }

    /* Layout structure */
    #sidebar-wrapper {
        width: 260px;
        min-width: 260px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: var(--sidebar-bg);
        display: flex;
        flex-direction: column;
        z-index: 1030;
        box-shadow: 4px 0 25px rgba(30, 45, 36, 0.15);
        transition: transform 0.3s ease;
    }

    #main-content-wrapper {
        margin-left: 260px;
        width: calc(100% - 260px);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background-color: var(--bg-main);
        transition: margin-left 0.3s ease, width 0.3s ease;
    }

    /* Top Navbar */
    .admin-navbar {
        height: 72px;
        background: rgba(251, 248, 241, 0.94);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border-color);
        position: sticky;
        top: 0;
        z-index: 1020;
        display: flex;
        align-items: center;
        padding: 0 32px;
    }

    /* Sidebar Content */
    .sidebar-brand {
        padding: 24px 20px 16px;
        border-bottom: 1px solid var(--sidebar-border);
    }

    .brand-mark {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, #8FB39A 0%, #3F6049 100%); /* Adaçayı yeşili vurgu */
        color: #fff;
        font-weight: 800;
        font-size: 1.25rem;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(85, 122, 94, 0.3);
    }

    .sidebar-user-card {
        padding: 14px 16px;
        margin: 14px 14px 8px;
        background: var(--sidebar-surface);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sidebar-user-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #8FB39A, #E6EEDD);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2F3A32;
        font-weight: 700;
        font-size: 0.85rem;
        border: 2px solid rgba(255, 255, 255, 0.25);
    }

    .sidebar-nav-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 10px 14px;
    }

        .sidebar-nav-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .sidebar-nav-scroll::-webkit-scrollbar-thumb {
            background: rgba(230, 238, 221, 0.15);
        }

    .nav-group-title {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(230, 238, 221, 0.5);
        margin: 18px 10px 8px;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 12px;
        border-radius: var(--radius-md);
        color: var(--sidebar-text);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 500;
        transition: var(--transition-base);
        position: relative;
    }

        .sidebar-link i {
            font-size: 1.05rem;
            color: rgba(230, 238, 221, 0.7);
            transition: var(--transition-base);
        }

        .sidebar-link:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.06);
        }

            .sidebar-link:hover i {
                color: #ffffff;
                transform: translateX(2px);
            }

        .sidebar-link.active {
            background-color: var(--sidebar-active);
            color: var(--sidebar-active-text);
            font-weight: 600;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
        }

            .sidebar-link.active i {
                color: #FFFFFF;
            }

            .sidebar-link.active::before {
                content: '';
                position: absolute;
                left: -8px;
                top: 6px;
                bottom: 6px;
                width: 4px;
                border-radius: 4px;
                background: #C9D9C4;
            }

    /* Sidebar Footer Promo Card */
    .sidebar-footer-box {
        padding: 14px;
        margin: 8px 14px 12px;
        background: linear-gradient(145deg, #3B5A46, #3B5A46); /* Koyu adaçayı */
        border-radius: var(--radius-md);
        border: 1px solid rgba(230, 238, 221, 0.12);
        position: relative;
        overflow: hidden;
    }

        .sidebar-footer-box::after {
            content: '';
            position: absolute;
            top: -20px;
            right: -20px;
            width: 70px;
            height: 70px;
            background: radial-gradient(circle, rgba(143, 179, 154, 0.3) 0%, transparent 70%);
            pointer-events: none;
        }

    /* Custom Form & Search in Navbar */
    .nav-search-input {
        background-color: #F4EFE3;
        border: 1px solid transparent;
        border-radius: 30px;
        padding: 7px 16px 7px 38px;
        font-size: 0.85rem;
        width: 220px;
        color: var(--text-primary);
        transition: var(--transition-base);
    }

        .nav-search-input:focus {
            background-color: #FFFFFF;
            border-color: var(--primary-accent);
            box-shadow: 0 0 0 3px rgba(85, 122, 94, 0.15);
            outline: none;
            width: 270px;
        }

    .nav-search-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

        .nav-search-wrap i {
            position: absolute;
            left: 13px;
            color: var(--text-secondary);
            pointer-events: none;
            font-size: 0.9rem;
        }

    /* Buttons */
    .btn-pastel-primary {
        background-color: var(--primary-accent);
        color: #FFFFFF;
        border: 1px solid var(--primary-accent);
        border-radius: var(--radius-md);
        font-weight: 600;
        padding: 9px 18px;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: var(--transition-base);
        box-shadow: 0 4px 12px rgba(85, 122, 94, 0.25);
    }

        .btn-pastel-primary:hover, .btn-pastel-primary:focus {
            background-color: var(--primary-accent-hover);
            border-color: var(--primary-accent-hover);
            color: #FFFFFF;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(85, 122, 94, 0.32);
        }

        .btn-pastel-primary:active {
            transform: translateY(0);
        }

    .btn-pastel-outline {
        background-color: #FFFFFF;
        color: var(--text-primary);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        font-weight: 500;
        padding: 8px 16px;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: var(--transition-base);
    }

        .btn-pastel-outline:hover {
            background-color: #F6F2E8;
            border-color: #DDD6C3;
            color: var(--primary-accent);
        }

    .btn-icon-action {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        transition: var(--transition-base);
        background-color: transparent;
        color: var(--text-secondary);
    }

        .btn-icon-action:hover {
            background-color: var(--pastel-purple);
            color: var(--primary-accent);
        }

        .btn-icon-action.action-delete:hover {
            background-color: var(--soft-red);
            color: var(--soft-red-text);
        }

        .btn-icon-action.action-view:hover {
            background-color: var(--pastel-blue);
            color: var(--pastel-blue-text);
        }

    /* Content Cards */
    .content-card {
        background-color: var(--card-bg);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-subtle);
    }

    /* Stat Cards */
    .stat-card {
        background-color: var(--card-bg);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-color);
        padding: 20px 22px;
        box-shadow: var(--shadow-subtle);
        transition: var(--transition-base);
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 100%;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-card);
            border-color: #E3DCC8;
        }

    .stat-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    /* Pastel Badge Styles */
    .badge-pastel {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        letter-spacing: 0.01em;
    }

    .badge-pastel-active {
        background-color: var(--mint-green);
        color: var(--mint-green-text);
        border: 1px solid rgba(27, 122, 75, 0.15);
    }

    .badge-pastel-completed {
        background-color: var(--soft-gray);
        color: var(--soft-gray-text);
        border: 1px solid rgba(107, 111, 98, 0.15);
    }

    .badge-pastel-type {
        background-color: var(--pastel-blue);
        color: var(--pastel-blue-text);
        border: 1px solid rgba(91, 140, 133, 0.15);
    }

    .badge-pastel-purple {
        background-color: var(--pastel-purple);
        color: var(--pastel-purple-text);
    }

    .badge-pastel-peach {
        background-color: var(--peach);
        color: var(--peach-text);
    }

    /* Tech Tags */
    .tech-tag {
        font-size: 0.72rem;
        font-weight: 600;
        background-color: #F4EFE3;
        color: #4A5548;
        padding: 3px 8px;
        border-radius: 6px;
        display: inline-block;
        border: 1px solid #E9E3D3;
        white-space: nowrap;
    }

    .tech-tag-more {
        background-color: var(--pastel-purple);
        color: var(--pastel-purple-text);
        border-color: #CFE0CC;
    }

    /* Table Styles */
    .table-custom {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-custom thead th {
            background-color: #F6F2E8;
            color: var(--text-secondary);
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid var(--border-color);
            border-top: none;
            padding: 13px 20px;
        }

        .table-custom tbody tr {
            transition: background-color 0.15s ease;
        }

            .table-custom tbody tr:hover {
                background-color: #F6F2E8;
            }

        .table-custom tbody td {
            padding: 16px 20px;
            vertical-align: middle;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-primary);
        }

        .table-custom tbody tr:last-child td {
            border-bottom: none;
        }

    .company-avatar {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: linear-gradient(135deg, #EEF3E6, #DCE8D5);
        color: var(--primary-accent);
        font-weight: 700;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #CFE0CC;
        flex-shrink: 0;
    }

    /* Dropdowns */
    .dropdown-menu-custom {
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-dropdown);
        padding: 8px;
        min-width: 230px;
        animation: fadeInDropdown 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes fadeInDropdown {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .dropdown-menu-custom .dropdown-item {
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 0.86rem;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 500;
    }

        .dropdown-menu-custom .dropdown-item:hover {
            background-color: #F1EDE0;
            color: var(--primary-accent);
        }

        .dropdown-menu-custom .dropdown-item i {
            font-size: 1rem;
            color: var(--text-secondary);
        }

        .dropdown-menu-custom .dropdown-item:hover i {
            color: var(--primary-accent);
        }

    /* Notification dot */
    .notification-dot {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 8px;
        height: 8px;
        background-color: #F65151;
        border-radius: 50%;
        border: 2px solid #FFFFFF;
    }

    /* Modals */
    .modal-content {
        border-radius: var(--radius-xl);
        border: 1px solid var(--border-color);
        box-shadow: 0 25px 60px rgba(47, 58, 50, 0.16);
        overflow: hidden;
    }

    .modal-header {
        border-bottom: 1px solid var(--border-color);
        padding: 20px 28px;
        background-color: #FFFFFF;
    }

    .modal-body {
        padding: 26px 28px;
    }

    .modal-footer {
        border-top: 1px solid var(--border-color);
        padding: 16px 28px;
        background-color: #FAF7EF;
    }

    /* Form controls in modal */
    .form-label {
        font-size: 0.83rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid #DDD6C3;
        padding: 9px 13px;
        font-size: 0.88rem;
        color: var(--text-primary);
        transition: var(--transition-base);
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-accent);
            box-shadow: 0 0 0 3px rgba(85, 122, 94, 0.14);
        }

    .form-check-input:checked {
        background-color: var(--primary-accent);
        border-color: var(--primary-accent);
    }

    /* Tags input style container */
    .tags-preview-container {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

    /* Toast Container */
    .toast-container {
        z-index: 1090;
    }

    .custom-toast {
        border-radius: var(--radius-md);
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px rgba(47, 58, 50, 0.12);
        font-size: 0.875rem;
        background: #FFFFFF;
    }

    /* Responsive adjustments */
    @@media (max-width: 991.98px) {
        #sidebar-wrapper {
            transform: translateX(-100%);
        }

        #main-content-wrapper {
            margin-left: 0;
            width: 100%;
        }

        .admin-navbar {
            padding: 0 20px;
        }

        .main-body-container {
            padding: 20px 16px !important;
        }

        .nav-search-input {
            width: 160px;
        }

            .nav-search-input:focus {
                width: 200px;
            }
    }

    .experience-count {
        background: #F6F2E8;
        padding: 12px 22px;
        border-radius: 10px;
        text-align: center;
        min-width: 130px;
    }

    .table thead th {
        background-color: #F6F2E8;
        color: #7A8479;
        font-size: 13px;
        font-weight: 600;
        padding: 16px;
        border-bottom: 1px solid #E9E3D3;
        white-space: nowrap;
    }

    .table tbody td {
        padding: 16px;
        font-size: 14px;
        border-bottom: 1px solid #EFEADC;
    }

    .table tbody tr:last-child td {
        border-bottom: none;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

        .status-badge.active {
            background-color: #dcfce7;
            color: #15803d;
        }

        .status-badge.passive {
            background-color: #fee2e2;
            color: #b91c1c;
        }


    .btn {
        border-radius: 7px;
        font-weight: 500;
    }

    /* Form Card */
    .form-card {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-subtle);
    }

    .form-card-header {
        padding: 20px 26px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .form-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: var(--pastel-purple);
        color: var(--primary-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .form-card-body {
        padding: 26px;
    }

    .form-card-footer {
        padding: 16px 26px;
        border-top: 1px solid var(--border-color);
        background: #FAF7EF;
        border-radius: 0 0 var(--radius-lg) var(--radius-lg);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    /* Form Controls */
    .form-label {
        font-size: 0.83rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 6px;
    }

        .form-label .req {
            color: #c0342b;
        }

    .form-control,
    .form-select {
        border-radius: 10px;
        border: 1px solid #DDD6C3;
        padding: 9px 13px;
        font-size: 0.88rem;
    }

    .input-icon-wrap {
        position: relative;
    }

        .input-icon-wrap i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
            pointer-events: none;
        }

        .input-icon-wrap .form-control,
        .input-icon-wrap .form-select {
            padding-left: 38px;
        }

    /* Status Box */
    .status-box {
        border: 1px solid #DDD6C3;
        border-radius: 10px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .form-switch .form-check-input {
        width: 2.6em;
        height: 1.35em;
        cursor: pointer;
    }

    .form-check-input:checked {
        background-color: var(--primary-accent);
        border-color: var(--primary-accent);
    }

    /* Form Buttons */
    .btn-accent {
        background: var(--primary-accent);
        border: 1px solid var(--primary-accent);
        color: #fff;
        border-radius: 12px;
        font-weight: 600;
        padding: 9px 20px;
        box-shadow: 0 4px 12px rgba(85, 122, 94, 0.25);
    }

        .btn-accent:hover {
            background: var(--primary-accent-hover);
            color: #fff;
        }

    .btn-soft {
        background: #fff;
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        border-radius: 12px;
        font-weight: 500;
        padding: 9px 18px;
    }

        .btn-soft:hover {
            background: #F6F2E8;
            color: var(--primary-accent);
        }

    /* Validation */
    .field-validation-error {
        font-size: 0.78rem;
        color: #c0342b;
    }

</style>