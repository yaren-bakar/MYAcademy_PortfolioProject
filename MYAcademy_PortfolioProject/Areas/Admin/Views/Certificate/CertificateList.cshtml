@model List<MYAcademy_PortfolioProject.Entities.Certificate>

@{
    ViewData["Title"] = "Sertifika Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Sertifika Yönetimi</h3>
            <p class="text-muted mb-0">
                Sertifikalarınızı buradan yönetebilirsiniz.
            </p>
        </div>

        <a href="/Admin/Certificate/CreateCertificate"
           class="btn btn-success">
            <i class="fas fa-plus me-2"></i> Yeni Sertifika Ekle
        </a>
    </div>

    <!-- Sertifika Tablosu -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Sertifikalarım</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Sertifika Adı</th>
                            <th>Kurum Adı</th>
                            <th>Tarih</th>
                            <th>Açıklama</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CertificateID</td>

                                <td class="fw-semibold">
                                    @item.Title
                                </td>

                                <td>@item.Institution</td>

                                <td>
                                    @item.CertificateDate
                                </td>

                                <td>
                                    @item.Description
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>

                                <td>
                                    <a href="/Admin/Certificate/UpdateCertificate/@item.CertificateID"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil-square"></i>
                                        Güncelle
                                    </a>
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-@item.CertificateID">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            @foreach (var item in Model)
            {
                <div class="modal fade"
                     id="deleteModal-@item.CertificateID"
                     tabindex="-1">

                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title">Silme Onayı</h5>
                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal">
                                </button>
                            </div>

                            <div class="modal-body">
                                @item.Title adlı sertifikayı silmek istediğinize emin misiniz?
                            </div>

                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-secondary"
                                        data-bs-dismiss="modal">
                                    Vazgeç
                                </button>

                                <a href="/Admin/Certificate/DeleteCertificate/@item.CertificateID"
                                   class="btn btn-danger">
                                    Evet, Sil
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-4 text-muted">
                    Henüz sertifika bilgisi eklenmemiş.
                </div>
            }

        </div>
    </div>

</div>
