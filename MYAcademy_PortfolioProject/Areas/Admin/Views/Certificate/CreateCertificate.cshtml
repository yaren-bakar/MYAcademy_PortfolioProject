@model MYAcademy_PortfolioProject.Entities.Certificate

@{
    ViewData["Title"] = "Sertifika Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white p-4">
                    <h4 class="fw-bold mb-1">Yeni Sertifika Ekle</h4>
                    <p class="text-muted mb-0">
                        Sertifika bilgilerinizi aşağıdaki formdan ekleyebilirsiniz.
                    </p>
                </div>

                <div class="card-body p-4">

                    <form method="post">

                        <div class="row g-4">

                            <div class="col-md-6">
                                <label asp-for="Title" class="form-label fw-semibold">
                                    Sertifika Adı
                                </label>
                                <input type="text" asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Institution" class="form-label fw-semibold">
                                    Kurum Adı
                                </label>
                                <input type="text" asp-for="Institution" class="form-control" />
                                <span asp-validation-for="Institution" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CertificateDate" class="form-label fw-semibold">
                                    Sertifika Tarihi
                                </label>
                                <input type="date" asp-for="CertificateDate" class="form-control" />
                                <span asp-validation-for="CertificateDate" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    Açıklama
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="checkbox" asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label">
                                        Aktif
                                    </label>
                                </div>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">

                            <a href="/Admin/Certificate/CertificateList"
                               class="btn btn-outline-secondary">
                                Vazgeç
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-plus-circle me-1"></i>
                                Sertifikayı Kaydet
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
