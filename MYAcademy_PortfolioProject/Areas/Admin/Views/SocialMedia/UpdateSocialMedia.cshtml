@model MYAcademy_PortfolioProject.Entities.SocialMedia

@{
    ViewData["Title"] = "Sosyal Medya Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white p-4">
                    <h4 class="fw-bold mb-1">Sosyal Medya Hesabı Güncelle</h4>
                    <p class="text-muted mb-0">
                        Sosyal medya bilgilerinizi güncelleyebilirsiniz.
                    </p>
                </div>

                <div class="card-body p-4">

                    <form method="post">

                        <input type="hidden" asp-for="SocialMediaID" />

                        <div class="row g-4">

                            <div class="col-md-6">
                                <label asp-for="PlatformName" class="form-label fw-semibold">
                                    Platform Adı
                                </label>
                                <input type="text" asp-for="PlatformName"
                                       class="form-control" />
                                <span asp-validation-for="PlatformName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Url" class="form-label fw-semibold">
                                    Profil Bağlantısı
                                </label>
                                <input type="text" asp-for="Url"
                                       class="form-control" />
                                <span asp-validation-for="Url" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Icon" class="form-label fw-semibold">
                                    İkon Sınıfı
                                </label>
                                <input type="text" asp-for="Icon"
                                       class="form-control" />
                                <span asp-validation-for="Icon" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <input type="checkbox" asp-for="IsActive"
                                           class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label">
                                        Aktif
                                    </label>
                                </div>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">

                            <a href="/Admin/SocialMedia/SocialMediaList"
                               class="btn btn-outline-secondary">
                                Vazgeç
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-pencil-square me-1"></i>
                                Değişiklikleri Kaydet
                            </button>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
