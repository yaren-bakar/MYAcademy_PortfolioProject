@{
    ViewData["Title"] = "Site Ayarları";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}


<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h3 class="fw-bold mb-1">Site Ayarları</h3>
        <p class="text-muted mb-0">
            Kişisel portfolyo siten hakkında genel bilgiler.
        </p>
    </div>

    <!-- Hoş Geldin Kartı -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center">
                </div>
                <div>
                    <h4 class="fw-bold mb-1">Yönetim Paneline Hoş Geldin! 👋</h4>
                    <p class="text-muted mb-0">
                        Kişisel portfolyo web sitenin yönetim alanındasın.
                        Buradan çalışmalarını, projelerini, eğitimlerini ve
                        diğer içeriklerini yönetebilirsin.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0 p-4 pb-0">
            <h5 class="fw-bold mb-0">
                <i class="fas fa-laptop-code me-2 text-primary"></i>
                Geliştirici Hakkında
            </h5>
        </div>
        <div class="card-body p-4">
            <p class="text-muted mb-3">
                Bu kişisel portfolyo projesi, yazılım geliştirme alanındaki
                bilgi ve deneyimlerimi sergilemek amacıyla hazırlanmıştır.
            </p>
            <p class="text-muted mb-0">
                Proje kapsamında ASP.NET Core MVC, C#, Entity Framework Core
                ve SQL Server teknolojileri kullanılarak dinamik bir web
                uygulaması geliştirilmiştir.
            </p>
        </div>
    </div>

    <div class="text-center mt-4">
        <p class="text-muted small mb-0">
            Kişisel Portfolyo Yönetim Paneli
            <span class="mx-1">•</span>
            ASP.NET Core MVC
        </p>
    </div>

</div>
