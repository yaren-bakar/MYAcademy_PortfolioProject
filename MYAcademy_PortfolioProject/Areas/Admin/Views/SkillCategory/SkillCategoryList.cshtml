@model List<MYAcademy_PortfolioProject.Entities.SkillCategory>

@{
    ViewData["Title"] = "Yetenek Kategorileri Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h3 class="fw-bold mb-1">Yetenek Kategorileri Yönetimi</h3>
        <p class="text-muted mb-0">Yetenek kategorilerinizi buradan yönetebilirsiniz.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-layers me-1"></i> Yetenek Kategorileri
            </h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 70px;">#</th>
                            <th>Kategori Adı</th>
                            <th>Açıklama</th>
                            <th>İkon</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int count = 0;
                        }
                        @foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td class="ps-4 fw-semibold text-muted">@count</td>
                                <td class="fw-bold text-secondary">@item.CategoryName</td>
                                <td class="text-muted">@item.Description</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">@item.Icon</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/Admin/SkillCategory/UpdateSkillCategory/@item.SkillCategoryID" class="btn btn-sm btn-outline-primary px-3 me-1">
                                        <i class="bi bi-pencil-square me-1"></i> Düzenle
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger px-3"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-@item.SkillCategoryID">
                                        <i class="bi bi-trash me-1"></i> Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @foreach (var item in Model)
            {
                <div class="modal fade" id="deleteModal-@item.SkillCategoryID" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Silme Onayı</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <strong>@item.CategoryName</strong> kategorisini silmek istediğinize emin misiniz?
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                                <a href="/Admin/SkillCategory/DeleteSkillCategory/@item.SkillCategoryID" class="btn btn-danger">Evet, Sil</a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-info-circle display-6 d-block mb-2"></i>
                    Henüz eklenmiş bir kategori bulunmuyor. Aşağıdaki butondan ilk kategorinizi ekleyebilirsiniz.
                </div>
            }
        </div>
    </div>

    <br />
    <a href="/Admin/SkillCategory/CreateSkillCategory" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i> Yeni Kategori Ekle
    </a>
</div>