@model MYAcademy_PortfolioProject.Entities.Contact

<section id="contact" style="background-color: var(--bg-secondary);">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">İLETİŞİME GEÇELİM</span>
            <h2 class="section-title">Birlikte Harika İşler Üretebiliriz.</h2>
            <p class="section-subtitle">Yeni projeler, iş birlikleri veya yalnızca merhaba demek için benimle iletişime geçebilirsiniz.</p>
        </div>

        <div class="row g-5">
            <div class="col-lg-5 reveal-on-scroll">
                <div class="contact-info-card">
                    <h4 class="fs-4 fw-bold mb-3">İletişim Bilgileri</h4>
                    <p class="text-secondary mb-4">@Model.Description</p>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-purple"><i class="bi bi-envelope"></i></div>
                        <div>
                            <div class="text-secondary small fw-medium">E-posta</div>
                            <a href="mailto:@Model.Email" class="text-decoration-none fw-bold text-dark">@Model.Email</a>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-blue"><i class="bi bi-geo-alt"></i></div>
                        <div>
                            <div class="text-secondary small fw-medium">Konum</div>
                            <div class="fw-bold text-dark">@Model.Location</div>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-mint"><i class="bi bi-linkedin"></i></div>
                        <div>
                            <div class="text-secondary small fw-medium">LinkedIn</div>
                            <a href="@(Model.Linkedin.StartsWith("http") ? Model.Linkedin : "https://" + Model.Linkedin)" target="_blank" class="text-decoration-none fw-bold text-dark">@Model.Linkedin</a>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-peach"><i class="bi bi-github"></i></div>
                        <div>
                            <div class="text-secondary small fw-medium">GitHub</div>
                            <a href="@(Model.Github.StartsWith("http") ? Model.Github : "https://" + Model.Github)" target="_blank" class="text-decoration-none fw-bold text-dark">@Model.Github</a>
                        </div>
                    </div>

                    <div class="mt-4 p-3 rounded-4 bg-white border border-light-subtle">
                        <div class="d-flex align-items-center gap-2 text-secondary small">
                            <i class="bi bi-clock-history text-primary"></i> @Model.SubDescription
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7 reveal-on-scroll">
                <div class="contact-form-card">
                    <form method="post" action="/Default/SendMessage">
                        @if (TempData["MessageSent"] != null)
                        {
                            <div class="alert alert-success border-0 rounded-3 small py-2 px-3 mb-4">
                                <i class="bi bi-check-circle-fill me-2"></i> @TempData["MessageSent"]
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Adınız Soyadınız *</label>
                                <input type="text" class="form-control" name="NameSurname" placeholder="Örn: Ahmet Yılmaz" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">E-posta Adresiniz *</label>
                                <input type="email" class="form-control" name="Email" placeholder="Örn: ahmet@example.com" required>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Konu *</label>
                                <input type="text" class="form-control" name="Subject" placeholder="Örn: Proje İş Birliği veya Danışmanlık" required>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Mesajınız *</label>
                                <textarea class="form-control" name="MessageDetail" rows="5" placeholder="Projeniz veya paylaşmak istedikleriniz hakkında detay verebilirsiniz..." required></textarea>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn-custom-primary w-100 justify-content-center py-3">
                                    <i class="bi bi-send-fill"></i> Mesaj Gönder
                                </button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>
